# KREO — variables d'environnement
# Copier vers .env et remplir, ou configurer dans Render.

# Base de données Turso (obligatoire en production)
# turso db show --url  →  libsql://kreo-xxxxx.turso.io
TURSO_DATABASE_URL=libsql://VOTRE-BASE.turso.io
TURSO_AUTH_TOKEN=VOTRE_JETON_TURSO

# En développement local, laisser tomber les deux ci-dessus :
# le serveur utilise alors un fichier SQLite local (./data/kreo.db).

# Port d'écoute (Render fournit PORT automatiquement)
PORT=8000

# production → cookies de session en Secure
NODE_ENV=production
